# Copy to .env only when changing defaults. Never commit .env.
HEALTHVAULT_DATA_DIR=./data
HEALTHVAULT_HOST=127.0.0.1
HEALTHVAULT_PORT=8765
HEALTHVAULT_SESSION_MINUTES=30
# Set to true only when you have configured local HTTPS for LAN access.
HEALTHVAULT_SECURE_COOKIES=false
HEALTHVAULT_OLLAMA_URL=http://127.0.0.1:11434
HEALTHVAULT_OLLAMA_MODEL=
